{
  "name": "persaka/codebreaker-api",
  "description": "Leaderboard API for PERSAKA Memory Codebreaker (Slim 4 + MySQL)",
  "type": "project",
  "require": {
    "php": "^8.1",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "slim/slim": "^4.12",
    "slim/psr7": "^1.6"
  },
  "config": {
    "process-timeout": 0
  },
  "autoload": { "psr-4": { "App\\": "src/" } },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "php -S localhost:8000 -t public"
    ]
  }
}
